@model IEnumerable<Example.Models.Student>

<h1><b>Thông tin sinh viên lớp K19</b></h1>

<table class="table table-bordered">

    <tr>
        <th>STT</th>
        <th>Tên</th>
        <th>Tuổi</th>
        <th>Giới tính</th>
        <th>Hình ảnh</th>
        <th>Chi tiết</th>
        <th>Chỉnh sửa</th>
        <th>Xóa</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Age</td>

            @if (item.Gender)
            {
                <td>Nam</td>
            }
            else
            {
                <td>Nữ</td>
            }

            <td>
                <img src="@item.ImgUrl" width="60" />
            </td>

            <td>@Html.ActionLink("Detail", "ListOnlyStudent", new { id = item.Id })</td>
            <td>@Html.ActionLink("Edit", "EditStudent", new { id = item.Id })</td>
            <td>@Html.ActionLink("Delete", "DelStudent", new { id = item.Id })</td>
        </tr>
    }

</table>

<p>
    @Html.ActionLink("Add", "AddStudent")
</p>